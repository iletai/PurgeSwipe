#include "Shared.xcconfig"

// Dev: own backend, TestFlight internal ("<App> Dev" ASC record).
APP_ENV = dev
APP_BUNDLE_IDENTIFIER = com.iletai.purgeswipe.dev
APP_DISPLAY_NAME = PurgeSwipe Dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev
CODE_SIGN_ENTITLEMENTS = Config/Entitlements/PurgeSwipe-Dev.entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEV
APP_STORE_URL =
// Dev ASC record's subscription group id; keep App/StoreKit/Products.storekit's group id identical.
SUBSCRIPTION_GROUP_ID = 21000001
// microCMS tenant serving the `app-update` object API (Dev backend); the GET-only key goes in Secrets.xcconfig.
MICROCMS_SERVICE_DOMAIN = purgeswipe
