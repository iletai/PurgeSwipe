DEVELOPMENT_TEAM = AP58YLHQ2S
CODE_SIGN_STYLE = Automatic
// One version for every environment; bumped on release/x.y.z. CI sets the build number.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// In-app support contact (the apps-site page uses the same address).
SUPPORT_EMAIL = iletai@hotmail.com

// Local secrets (gitignored); CI writes this file from repo secrets. See Secrets.xcconfig.example.
#include? "Secrets.xcconfig"
// Google's sample AdMob app ID; the SDK crashes at launch without a valid one.
ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
// Google's sample banner unit; swap per environment when real ad units exist.
ADMOB_BANNER_UNIT_ID = ca-app-pub-3940256099942544/2435281174
