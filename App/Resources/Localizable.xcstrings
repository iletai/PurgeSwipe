    "help.answer.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the main screen and follow the prompts. You can revisit this guide in Settings."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở màn hình chính và làm theo hướng dẫn. Bạn có thể xem lại hướng dẫn trong Cài đặt."
          }
        }
      }
    },
    "help.answer.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data is stored on your device. See the privacy policy for details."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu được lưu trên thiết bị của bạn. Chi tiết xem trong chính sách quyền riêng tư."
          }
        }
      }
    },
    "help.answer.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings and choose Appearance."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt và chọn Giao diện."
          }
        }
      }
    },
    "help.answer.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store purchases are handled by Apple. Use the Request a Refund link below."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch App Store do Apple xử lý. Dùng liên kết Yêu cầu hoàn tiền bên dưới."
          }
        }
      }
    },
