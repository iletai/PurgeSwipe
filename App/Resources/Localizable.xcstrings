    "help.answer.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No. Analysis runs on this iPhone. There is no account, no cloud and no analytics."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không. Việc phân tích diễn ra trên iPhone này. Không tài khoản, không đám mây, không phân tích sử dụng."
          }
        }
      }
    },
    "help.answer.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They move to Recently Deleted in Photos. Finish in Photos to remove them from the device."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng được chuyển vào Đã xóa gần đây trong Ảnh. Hoàn tất trong Ảnh để xóa khỏi máy."
          }
        }
      }
    },
    "help.answer.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos stored only in iCloud are skipped. PurgeSwipe never downloads them."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh chỉ lưu trên iCloud sẽ bị bỏ qua. PurgeSwipe không bao giờ tải chúng về."
          }
        }
      }
    },
    "help.answer.4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store purchases are handled by Apple. Use the Request a Refund link below."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao dịch App Store do Apple xử lý. Dùng liên kết Yêu cầu hoàn tiền bên dưới."
          }
        }
      }
    },
